FROM gradle:9.1-jdk21 AS build

WORKDIR /workspace

COPY settings.gradle.kts build.gradle.kts ./
COPY backend ./backend

RUN gradle :backend:bootJar \
    --no-daemon \
    --stacktrace


FROM eclipse-temurin:21-jdk

WORKDIR /app

COPY --from=build \
    /workspace/backend/build/libs/backend-*.jar \
    /app/app.jar

RUN useradd --system --uid 10001 jvmlens

USER 10001

ENV JVM_LENS_WORKSPACE=/tmp/jvm-lens
ENV JAVA_TOOL_OPTIONS="-Xms64m -Xmx384m -XX:+UseSerialGC -XX:MaxMetaspaceSize=192m -XX:MaxDirectMemorySize=64m -XX:+ExitOnOutOfMemoryError"

ENTRYPOINT ["sh", "-c", "mkdir -p /tmp/jvm-lens && exec java -Djava.io.tmpdir=/tmp -jar /app/app.jar"]
