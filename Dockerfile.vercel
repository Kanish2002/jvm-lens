FROM gradle:9.1-jdk25 AS build

WORKDIR /workspace

COPY settings.gradle.kts build.gradle.kts ./
COPY backend ./backend

RUN gradle :backend:bootJar --no-daemon


FROM eclipse-temurin:25-jdk

RUN useradd --system --uid 10001 jvmlens \
    && mkdir -p /tmp/jvm-lens \
    && chown -R jvmlens /tmp/jvm-lens

USER jvmlens

COPY --from=build /workspace/backend/build/libs/backend-*.jar /app.jar

ENV JAVA_TOOL_OPTIONS="-Djava.io.tmpdir=/tmp/jvm-lens"

EXPOSE 8080

ENTRYPOINT ["java", "-jar", "/app.jar"]